# --- DATABASE_URL -----------------------------------------------------------
# Local development (this machine only, file is git-ignored):
#   DATABASE_URL=sqlite:///./inventory.db
# Production (Render dashboard > Environment > Environment Variables):
#   paste the Neon PostgreSQL connection string, e.g.
#   DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
# A postgres:// scheme is accepted too (normalized to postgresql://).
# Never commit real credentials; on Render the app refuses to start unless
# DATABASE_URL is a PostgreSQL URL (no silent SQLite fallback).
DATABASE_URL=your_neon_postgresql_connection_string
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173", "https://frolicking-daifuku-dc66bb.netlify.app"]
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Python version pin (used by deployment platforms like Render)
PYTHON_VERSION=3.13.4

# OpenRouter fallback (NVIDIA Nemotron 3) — used when Gemini quota is exhausted
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
